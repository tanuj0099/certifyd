    `🚀 5-yr ROI: ${roiPercent}%\n\n` +
    `Calculated at certifyroi.in — India salary data 2026`

  function handleCopy() {
    navigator.clipboard.writeText(shareText).then(function() {
      setCopied(true)
      setTimeout(function() { setCopied(false) }, 2000)
    })
  }

  function handleShare() {
    if (navigator.share) {
      navigator.share({ title: displayName + ' ROI Analysis', text: shareText }).catch(function() {})
    } else {
      handleCopy()
    }
  }

  return (
    <motion.div
      initial={{ opacity: 0, y: 8 }}
      animate={{ opacity: 1, y: 0 }}
      transition={{ duration: 0.28, ease: [0.4, 0, 0.2, 1] }}
