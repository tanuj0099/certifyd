# PostHog analytics configuration
# Copy this file to .env and fill in your real PostHog project key.
VITE_POSTHOG_KEY=your_posthog_api_key_here
# Optional: override the default PostHog host if you self-host.
# VITE_POSTHOG_API_HOST=https://app.posthog.com

# Test safety switches. Use these in CI/local automation to prevent live
# PostHog, Groq, Claude, AWS, or database writes unless a staging job opts in.
VITE_TEST_MODE=false
TEST_MODE=false
