// ── ShareROICard — a shareable summary card with copy/share ──────────────────
// Props: certName, name, breakEven, fiveYearGain, monthlyGain, roiPercent, newSalary
export default function ShareROICard({ certName, name, breakEven, fiveYearGain, monthlyGain, roiPercent, newSalary }) {
  const [copied, setCopied] = useState(false)

  if (!certName || !breakEven || breakEven <= 0) return null

  const displayName = name ? name.split(' ')[0] + '\'s' : 'My'

  const shareText =
    `📊 ${displayName} ${certName} ROI Analysis\n` +
    `💰 New salary: ₹${newSalary}L/yr\n` +
