// CERT ASSEMBLY
// ΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇΓöÇ
function CertAssembly() {
  const C = useTheme()
  const isMobile = useIsMobile()
  const trackRef = useRef(null)
  const { scrollY } = useScroll()
  const [prog, setProg] = useState(0)

  useEffect(() => {
    const update = () => {
      const el = trackRef.current; if (!el) return
      const r = el.getBoundingClientRect()
      const t = el.offsetHeight - window.innerHeight
      if (t <= 0) return
      setProg(Math.max(0, Math.min(1, -r.top / t)))
    }
    const unsub = scrollY.on('change', update)
    update()
    return unsub
  }, [scrollY])

  const rm = (p, a, b, c, d) => c + (d - c) * Math.max(0, Math.min(1, (p - a) / (b - a)))
  const p8 = rm(prog, 0, 0.75, 0, 1)

  let l1, l2
  if (isMobile) {
    l1 = `translateY(${rm(p8, 0, 1, -36, 0)}px) rotateZ(${rm(p8, 0, 1, 1.8, 0)}deg)`
    l2 = `translateY(${rm(p8, 0, 1, 36, 0)}px) rotateZ(${rm(p8, 0, 1, -1.2, 0)}deg)`
  } else {
    l1 = `perspective(1200px) translateZ(${rm(p8, 0, 1, -200, 0)}px) translateY(${rm(p8, 0, 1, -50, 0)}px) rotateY(${rm(p8, 0, 1, 26, 0)}deg) rotateX(${rm(p8, 0, 1, 10, 0)}deg)`
    l2 = `perspective(1200px) translateZ(${rm(p8, 0, 1, 200, 0)}px) translateY(${rm(p8, 0, 1, 50, 0)}px) rotateY(${rm(p8, 0, 1, -20, 0)}deg) rotateX(${rm(p8, 0, 1, -8, 0)}deg)`
  }

  const sc = prog < 0.75 ? rm(prog, 0, 0.75, 0.65, 1.0) : rm(prog, 0.75, 1.0, 1.0, 0.92)
  const op = prog < 0.04 ? rm(prog, 0, 0.04, 0, 1) : prog > 0.88 ? rm(prog, 0.88, 1.0, 1, 0.25) : 1
  const hint = prog > 0.12 ? 0 : prog > 0.04 ? rm(prog, 0.04, 0.12, 1, 0) : 1
  const cw = isMobile ? 'min(290px, 84vw)' : 'min(420px, 68vw)'

  return (
    <div ref={trackRef} style={{ height: '200vh', position: 'relative', borderBottom: `1px solid ${C.border}`, background: C.bg }}>
      <div style={{ position: 'sticky', top: 0, height: '100vh', display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', overflow: 'hidden' }}>
        <motion.div initial={{ opacity: 0, y: 10 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }}
          style={{ fontFamily: F_MONO, fontSize: '11px', color: C.text3, letterSpacing: '0.2em', marginBottom: '28px', zIndex: 5, pointerEvents: 'none' }}>
          YOUR OUTPUT
        </motion.div>
        <div style={{ position: 'relative', zIndex: 4 }}>
          <div style={{ transform: `scale(${sc})`, opacity: op }}>
            <div style={{ position: 'relative', width: cw, height: `calc(${cw} / 1.414)`, transformStyle: 'preserve-3d' }}>
              <div style={{ position: 'absolute', inset: 0, transform: l1 }}>
                <svg viewBox="0 0 480 340" width="100%" height="100%" style={{ display: 'block' }}>
                  <defs><linearGradient id="cB" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stopColor={C.text4} /><stop offset="50%" stopColor={C.gold} /><stop offset="100%" stopColor={C.gold} /></linearGradient></defs>
                  <rect x="0" y="0" width="480" height="340" fill={C.certBg} style={{ filter: 'drop-shadow(0 20px 40px rgba(0,0,0,0.5))' }} />
                  <rect x="1.5" y="1.5" width="477" height="337" fill="none" stroke="url(#cB)" strokeWidth="1.5" />
                  <rect x="10" y="10" width="460" height="320" fill="none" stroke={C.borderMid} strokeWidth="0.7" />
                </svg>
              </div>
              <div style={{ position: 'absolute', inset: 0, transform: l2, display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', padding: '28px' }}>
                <div style={{ fontFamily: F_MONO, fontSize: '10px', color: C.gold, letterSpacing: '0.2em', marginBottom: '12px' }}>CERTIFYROI ┬╖ ROUTE ANALYSIS</div>
                <div style={{ fontFamily: F_SERIF, fontWeight: '400', fontSize: 'clamp(1.2rem, 2.8vw, 2rem)', color: C.text, marginBottom: '4px', textAlign: 'center', lineHeight: 1.1 }}>Route Briefing</div>
                <div style={{ fontFamily: F_SANS, fontSize: '12px', color: C.text3, marginBottom: '24px' }}>Personalised ┬╖ India 2026</div>
                <div style={{ display: 'flex', gap: '24px', marginBottom: '18px' }}>
                  {[{ l: 'PAYBACK', v: '6 mo' }, { l: '5-YR GAIN', v: 'Γé╣14.2L', c: C.gold }, { l: 'DELTA', v: '+35%' }].map((s, i) => (
                    <div key={i} style={{ textAlign: 'center' }}>
                      <div style={{ fontFamily: F_MONO, fontSize: '10px', color: C.text4, letterSpacing: '0.1em', marginBottom: '5px' }}>{s.l}</div>
                      <div style={{ fontFamily: F_MONO, fontSize: 'clamp(0.85rem, 2.2vw, 1.3rem)', color: s.c || C.text, fontWeight: '600' }}>{s.v}</div>
                    </div>
                  ))}
                </div>
                <div style={{ width: '65%', height: '1px', background: C.borderMid, marginBottom: '10px' }} />
                <div style={{ display: 'flex', alignItems: 'center', gap: '4px' }}>
                  <CheckCircle2 size={10} color={C.gold} />
                  <span style={{ fontFamily: F_MONO, fontSize: '10px', color: C.text3, letterSpacing: '0.1em' }}>FROM YOUR INPUTS</span>
                </div>
              </div>
            </div>
          </div>
          <div style={{ opacity: hint, marginTop: '28px', textAlign: 'center', pointerEvents: 'none' }}>
            <motion.div animate={{ y: [0, 5, 0] }} transition={{ duration: 1.5, repeat: Infinity, ease: 'easeInOut' }}>
              <div style={{ fontFamily: F_MONO, fontSize: '11px', color: C.text3, letterSpacing: '0.2em' }}>Γåô SCROLL TO ASSEMBLE Γåô</div>
            </motion.div>
          </div>
        </div>
      </div>
    </div>
  )
}

