                  return chip.ok ? (
                    <span key={i} style={{ padding: '3px 9px', borderRadius: '99px', fontSize: '10px', fontFamily: F_MONO, background: col + '15', border: '1px solid ' + col + '30', color: col }}>
                      {chip.label}
                    </span>
                  ) : null
                })}
