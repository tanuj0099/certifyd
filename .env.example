# =====================================================================
# CERTIFYD ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================
# INSTRUCTIONS:
# Copy this file to `.env` or `.env.local` and fill in your environment
# specific values. Never commit actual secret keys or credentials to git.

# ---------------------------------------------------------------------
# CLIENT-VISIBLE ENVIRONMENT VARIABLES (Next.js Public Bundle)
# NOTE: Only safe public identifiers and anon keys with active Row Level
# Security (RLS) policies should use the NEXT_PUBLIC_ prefix.
# ---------------------------------------------------------------------

# Supabase (Public URL & Anon Key - Protected by RLS on all tables)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_public_key_placeholder"

# Cloudflare Turnstile (Public Site Key for Anti-Bot Verification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAAPublicSiteKeyPlaceholder"

# PostHog Analytics (Client-side tracking)
NEXT_PUBLIC_POSTHOG_KEY="phc_your_posthog_project_api_key_placeholder"
NEXT_PUBLIC_POSTHOG_HOST="https://us.posthog.com"

# Firebase Client Configuration (Public Web App Identifiers)
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourFirebasePublicApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_APP_ID="1:1234567890:web:abcdef1234567890"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="1234567890"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"

# Application Feature Limits
NEXT_PUBLIC_GUEST_FREE_LIMIT=3

# ---------------------------------------------------------------------
# SERVER-SIDE ONLY ENVIRONMENT VARIABLES
# NEVER expose these to the browser (Do NOT prefix with NEXT_PUBLIC_)
# ---------------------------------------------------------------------

# Supabase Admin / Server Access (Bypasses RLS - Server Only!)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_secret_placeholder"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_secret_placeholder"

# AI / LLM Inference Providers
GROQ_API_KEY="gsk_your_groq_api_key_placeholder"
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key_placeholder"
OPENAI_API_KEY="sk-your_openai_api_key_placeholder"

# Scraping & Data Pipeline Services
APIFY_TOKEN="apify_api_your_token_placeholder"

# Authentication & Access Security
JWT_SECRET="your_secure_random_jwt_secret_at_least_32_characters"
TURNSTILE_SECRET_KEY="0x4AAAAAAASecretKeyPlaceholder"
ADMIN_EMAILS="admin@example.com,ops@example.com"

# Server-Side Rate Limiting (Upstash Redis)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="AXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Error & Performance Monitoring (Sentry)
SENTRY_DSN="https://key@o0.ingest.sentry.io/0"

# Python Data Engine (Reddit AI Extraction)
REDDIT_CLIENT_ID="your_reddit_client_id_placeholder"
REDDIT_CLIENT_SECRET="your_reddit_client_secret_placeholder"
REDDIT_USER_AGENT="CertifyROI_Data_Engine_v1.0"
