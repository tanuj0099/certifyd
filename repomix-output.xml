              Calculate ROI <ArrowRight size={13} />
            </PillBtn>
          </div>

          {/* ── Right: Pivot Domains ── */}
          <div>
            <div style={{ fontFamily: FM, fontSize: '10px', color: COOL_GREY, letterSpacing: '0.14em', marginBottom: '14px' }}>// PIVOT DOMAINS</div>
