# Firebase (required for sign-in)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (profile + feedback sync)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Admin access (comma-separated emails allowed at /admin)
VITE_ADMIN_EMAILS=you@example.com
ADMIN_EMAILS=you@example.com

# Cloudflare Turnstile (human verification on sign-in)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Server-only (Vercel env — never expose in client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_API_KEY=

# Optional
VITE_GUEST_FREE_LIMIT=3
