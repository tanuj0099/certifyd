      </div>
      {!exceedsSwitcherLimit && (
        <motion.div animate={{ x: hovered ? 3 : 0 }} transition={{ duration: 0.13 }}>
          <ArrowRight size={13} color={hovered ? col : 'var(--text-4)'} />
        </motion.div>
      )}
    </motion.div>
  )
}

