import { useState } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { MessageSquare, Copy, Check } from 'lucide-react'

const F_HEAD = "'Bricolage Grotesque','Plus Jakarta Sans',sans-serif"
const F_MONO = "'Commit Mono','JetBrains Mono',monospace"
const F_BODY = "'Inter',sans-serif"

// ── SalaryScript — negotiation script for users who've completed a cert ──────
// Props: certName, salaryBefore, salaryAfter, hikeAchieved, name, company
export default function SalaryScript({ certName, salaryBefore, salaryAfter, hikeAchieved, name, company }) {
  const [open,   setOpen]   = useState(false)
  const [copied, setCopied] = useState(false)

  if (!certName) return null

  const displayName = name    || 'there'
  const displayCo   = company || 'your employer'
  const gainL       = salaryAfter && salaryBefore
    ? ((salaryAfter - salaryBefore) / 100000).toFixed(1)
    : null

  const script =
`Opening Line:
"I wanted to discuss my compensation in light of my ${certName} certification, which I completed on [date]."

Evidence point:
"Since completing ${certName}, I've [specific contribution — e.g. reduced deployment time / improved uptime / led the cloud migration]. This directly reflects the skills the certification validates."

Market anchor:
"India market data for certified ${certName} professionals in my role shows a range of ${hikeAchieved || 30}–${(hikeAchieved || 30) + 10}% above my current salary. My target is ₹${salaryAfter ? (salaryAfter / 100000).toFixed(1) : '[target]'}L."

Cost to ${displayCo}:
"The cost to backfill my role at market rate would be significantly higher than aligning my current package to market. I'd like to resolve this without changing employment."

Close:
"I'd like to schedule 30 minutes with you to go through the data. Would [day] work?"
`

  function handleCopy() {
    navigator.clipboard.writeText(script).then(function() {
      setCopied(true)
      setTimeout(function() { setCopied(false) }, 2000)
    })
  }

  return (
    <div style={{ marginBottom: '10px' }}>
      <button
        onClick={function() { setOpen(function(v) { return !v }) }}
        style={{ width: '100%', padding: '9px 14px', borderRadius: '9px', background: open ? 'rgba(16,185,129,0.08)' : 'var(--surface)', border: '1px solid ' + (open ? 'rgba(16,185,129,0.25)' : 'var(--border)'), color: open ? '#10B981' : 'var(--text-3)', fontSize: '12px', cursor: 'pointer', fontFamily: F_BODY, fontWeight: '600', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '7px', transition: 'all 0.18s' }}
      >
        <MessageSquare size={13} />
        Salary Negotiation Script · {certName}
        {gainL && (
          <span style={{ marginLeft: 'auto', fontFamily: F_MONO, fontSize: '10px', color: '#10B981', background: 'rgba(16,185,129,0.1)', padding: '2px 7px', borderRadius: '4px', border: '1px solid rgba(16,185,129,0.2)' }}>
