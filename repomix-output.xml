              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '12px' }}>
                <div style={{ fontFamily: F_MONO, fontSize: '9px', color: '#10B981', textTransform: 'uppercase', letterSpacing: '0.1em' }}>
