            flexShrink: 0,
            transform: open ? 'rotate(180deg)' : 'rotate(0deg)',
            transition: 'transform 0.3s var(--ease-out)',
          }}
        />
      </button>
    </motion.div>
  )
}

export default function FAQPage() {
  return (
    <MarketingPageShell
