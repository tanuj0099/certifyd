          onClick={() => onTabChange('calculator')}
          whileHover={{ scale: 1.04, x: 3 }}
          whileTap={{ scale: 0.97 }}
          style={{ padding: '9px 18px', borderRadius: '9px', background: 'rgba(16,185,129,0.12)', border: '1px solid rgba(16,185,129,0.3)', color: '#10B981', fontSize: '13px', fontWeight: '700', cursor: 'pointer', fontFamily: 'Plus Jakarta Sans, sans-serif', display: 'flex', alignItems: 'center', gap: '6px', whiteSpace: 'nowrap' }}
        >
          Calculate ROI →
        </motion.button>
      </motion.div>
    )}
  </div>
)}

            {activeTab === 'calculator' && (
              <Hero mode={mode} prefilledCert={prefilledCert} resumeName={resumeName} />
            )}

            {activeTab === 'heatmap' && (
              <div className="glass" style={{ padding: '28px' }}>
                <Heatmap
                  prefilledCity={resumeCity}
                  prefilledDomain={resumeDomain}
                  certName={prefilledCert}
                  resumeName={resumeName}
                />
              </div>
            )}

            {activeTab === 'jobmap' && (
  <div className="glass" style={{ padding: '28px' }}>
    <JobCertMap />
  </div>
)}

            {activeTab === 'college' && (
              <div className="glass" style={{ padding: '28px' }}>
                <CollegeVsCorporate />
              </div>
            )}
          </div>
        </motion.div>
      </AnimatePresence>
    </div>
  )
}

// ─────────────────────────────────────────────────────────
// FOOTER
// ─────────────────────────────────────────────────────────
const Footer = ({ onNavigate }) => (
