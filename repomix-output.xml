  c.shadowBlur = 0

  var afterCert = midY - 40 + cLines.length * lH

  // ── Domain + Demand pills ────────────────────────────────
  var pillY   = afterCert + 38
  var domLabel = DOMAIN_LABELS[domain] || domain
  c.font = '12px "Courier New", monospace'

  var p1t = domLabel.toUpperCase()
