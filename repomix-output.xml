import { useState, useEffect } from 'react'
import { motion, AnimatePresence } from 'framer-motion'
import { Building2, TrendingUp, ChevronDown, ChevronUp } from 'lucide-react'
import { CERTIFICATIONS } from '../tokens.js'

const F_HEAD = "'Bricolage Grotesque','Plus Jakarta Sans',sans-serif"
const F_MONO = "'Commit Mono','JetBrains Mono',monospace"
const F_BODY = "'Inter',sans-serif"

// ── Top companies hiring for a given cert in India ───────────────────────────
// Derived from tokens.js CERTIFICATIONS data (topHiringCompanies field if present)
// Falls back to a curated static list per cert domain
const DOMAIN_COMPANIES = {
  cloud:   ['TCS', 'Infosys', 'Wipro', 'Accenture', 'HCLTech', 'Capgemini', 'Amazon', 'Microsoft', 'Google'],
  data:    ['Mu Sigma', 'Fractal', 'Tiger Analytics', 'ThoughtWorks', 'Flipkart', 'Swiggy', 'Razorpay'],
  devops:  ['ThoughtWorks', 'Xebia', 'Harness', 'Zepto', 'PhonePe', 'Atlassian', 'Red Hat'],
  pm:      ['Atlassian', 'Salesforce', 'Adobe', 'IBM', 'Cognizant', 'Mphasis'],
  finance: ['Deloitte', 'KPMG', 'EY', 'PwC', 'FinIQ', 'CRISIL', 'Fidelity', 'JP Morgan'],
  security:['Palo Alto', 'Wipro', 'HCL Cyber', 'IBM Security', 'E&Y Advisory', 'Deloitte'],
  default: ['TCS', 'Infosys', 'Wipro', 'Accenture', 'HCLTech', 'Capgemini', 'IBM'],
}

// ── CompanyTracker ───────────────────────────────────────────────────────────
// Props: certName, userCompany
export default function CompanyTracker({ certName, userCompany }) {
  const [open, setOpen] = useState(false)

  if (!certName) return null

  // Find the cert to get its domain
  const cert = CERTIFICATIONS.find(function(c) {
    return c.name.toLowerCase().includes(certName.toLowerCase()) ||
           certName.toLowerCase().includes(c.name.toLowerCase())
  })

  const domain    = cert?.domain || 'default'
  const companies = DOMAIN_COMPANIES[domain] || DOMAIN_COMPANIES.default

  // Check if user's company is in the list
  const userCoInList = userCompany &&
    companies.some(function(c) { return c.toLowerCase().includes(userCompany.toLowerCase()) })

  return (
    <div style={{ marginBottom: '16px' }}>
      <button
        onClick={function() { setOpen(function(v) { return !v }) }}
        style={{ width: '100%', padding: '9px 14px', borderRadius: '9px', background: open ? 'rgba(81,177,231,0.08)' : 'var(--surface)', border: '1px solid ' + (open ? 'rgba(81,177,231,0.25)' : 'var(--border)'), color: open ? '#51B1E7' : 'var(--text-3)', fontSize: '12px', cursor: 'pointer', fontFamily: F_BODY, fontWeight: '600', display: 'flex', alignItems: 'center', justifyContent: 'space-between', gap: '7px', transition: 'all 0.18s' }}
      >
        <div style={{ display: 'flex', alignItems: 'center', gap: '7px' }}>
          <Building2 size={13} />
          Companies hiring {certName} · India
        </div>
        {open ? <ChevronUp size={12} /> : <ChevronDown size={12} />}
      </button>

      <AnimatePresence>
        {open && (
          <motion.div
            key="companies"
            initial={{ opacity: 0, height: 0 }}
            animate={{ opacity: 1, height: 'auto' }}
            exit={{ opacity: 0, height: 0 }}
            transition={{ duration: 0.22, ease: [0.4, 0, 0.2, 1] }}
            style={{ overflow: 'hidden' }}
          >
