import { Briefcase, Copy, Check } from 'lucide-react'

const F_HEAD = "'Bricolage Grotesque','Plus Jakarta Sans',sans-serif"
const F_MONO = "'Commit Mono','JetBrains Mono',monospace"
const F_BODY = "'Inter',sans-serif"

// ── Pitch Boss — generates a salary negotiation pitch email ──────────────────
// Props: certName, salary, certCost, hikePercent, name, company, mode
export default function PitchBoss({ certName, salary, certCost, hikePercent, name, company, mode }) {
  const [open,   setOpen]   = useState(false)
  const [copied, setCopied] = useState(false)

  if (!certName) return null

  const newSalary    = salary > 0 ? (salary * (1 + hikePercent / 100)).toFixed(1) : null
  const displayName  = name    || 'there'
  const displayCo    = company || 'your company'
  const isStudent    = mode === 'student'

  const pitch = isStudent
    ? `Hi,

I'm currently preparing for the ${certName} certification as part of my career launch plan.

Based on current India market data (Naukri · AmbitionBox · LinkedIn 2026), this certification is associated with starting salaries of ₹4.8L+ in my target domain.

I'm investing ₹${certCost}L in this certification and expect to be fully certified within the next few months.

I'd love to discuss any relevant opportunities once I've completed this milestone.

Thanks,
${name || 'your name'}`
    : `Hi,

I'm writing to discuss my compensation following the completion of my ${certName} certification.

Based on current India market data (Naukri · AmbitionBox · LinkedIn India 2026), certified professionals in my role and city earn ${hikePercent}% above the base — a range that aligns with a move to ₹${newSalary}L/yr.

My investment in ${certName} (₹${certCost}L) has already returned value to ${displayCo} through [specific project / skill]. The market data suggests this is the right moment to align my compensation with that contribution.

I'd welcome a conversation about this.

Best,
${displayName}`

  function copyPitch() {
    navigator.clipboard.writeText(pitch).then(function() {
      setCopied(true)
      setTimeout(function() { setCopied(false) }, 2000)
    })
  }

  return (
    <div style={{ marginBottom: '10px' }}>
      <button
        onClick={function() { setOpen(function(v) { return !v }) }}
        style={{ width: '100%', padding: '9px 14px', borderRadius: '9px', background: open ? 'rgba(99,102,241,0.1)' : 'var(--surface)', border: '1px solid ' + (open ? 'rgba(99,102,241,0.3)' : 'var(--border)'), color: open ? 'var(--indigo-light)' : 'var(--text-3)', fontSize: '12px', cursor: 'pointer', fontFamily: F_BODY, fontWeight: '600', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '7px', transition: 'all 0.18s' }}
      >
        <Briefcase size={13} />
        {isStudent ? 'Draft Outreach Email' : 'Pitch Your Boss'}
      </button>

      <AnimatePresence>
        {open && (
          <motion.div
            key="pitch"
            initial={{ opacity: 0, height: 0 }}
            animate={{ opacity: 1, height: 'auto' }}
            exit={{ opacity: 0, height: 0 }}
            transition={{ duration: 0.22, ease: [0.4, 0, 0.2, 1] }}
            style={{ overflow: 'hidden' }}
          >
            <div style={{ marginTop: '8px', padding: '14px', borderRadius: '10px', background: 'var(--surface)', border: '1px solid var(--glass-border)' }}>
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '10px' }}>
                <div style={{ fontFamily: F_MONO, fontSize: '9px', color: 'var(--indigo-light)', textTransform: 'uppercase', letterSpacing: '0.1em' }}>
                  {isStudent ? 'OUTREACH TEMPLATE' : 'PITCH EMAIL · ' + certName.toUpperCase()}
                </div>
                <button
                  onClick={copyPitch}
                  style={{ padding: '4px 10px', borderRadius: '6px', background: copied ? 'rgba(16,185,129,0.1)' : 'var(--bg)', border: '1px solid ' + (copied ? 'rgba(16,185,129,0.3)' : 'var(--border)'), color: copied ? '#10B981' : 'var(--text-4)', fontSize: '11px', cursor: 'pointer', fontFamily: F_BODY, display: 'flex', alignItems: 'center', gap: '5px', transition: 'all 0.18s' }}
                >
                  {copied ? <Check size={11} /> : <Copy size={11} />}
                  {copied ? 'Copied' : 'Copy'}
                </button>
              </div>
              <pre style={{ fontFamily: F_BODY, fontSize: '12px', color: 'var(--text-2)', lineHeight: '1.7', whiteSpace: 'pre-wrap', wordBreak: 'break-word', margin: 0 }}>
                {pitch}
              </pre>
            </div>
          </motion.div>
        )}
      </AnimatePresence>
    </div>
  )
}
