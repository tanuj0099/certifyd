  h1 { word-break: break-word; }
}

/* ── Very small screens ────────────────────────────────── */
@media (max-width: 380px) {
  .hamburger-features { display: none !important; }

  .mode-selector-grid {
    grid-template-columns: repeat(3, 1fr) !important;
    gap: 6px !important;
  }
}

/* ── Navbar mobile optimisation ────────────────────────── */
@media (max-width: 768px) {
  /* Hide theme toggle on mobile — accessible in hamburger */
  .theme-toggle-desktop { display: none !important; }

  /* Tighten right-nav on mobile */
  .right-nav {
    gap: 6px !important;
  }

  /* Sign in button: icon-only on small screens */
  .signin-text { display: none; }
  .signout-text { display: none; }
}
