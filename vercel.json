{
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/update-salaries",
      "schedule": "0 6 * * 1"
    }
  ],
  "functions": {
    "api/update-salaries.js": {
      "maxDuration": 300
    }
  },
  "redirects": [
    {
      "source": "/roi-calculator",
      "destination": "/tools/roi"
    },
    {
      "source": "/offer-letter-analyzer",
      "destination": "/offer-analysis"
    },
    {
      "source": "/market-pulse",
      "destination": "/tools/market"
    }
  ]
}
