        'domain':          'Cybersecurity',
    }};
    Object.keys(flat).forEach(function(k) {{
        try {{ localStorage.setItem(k, flat[k]); }} catch(e) {{}}
        try {{ sessionStorage.setItem(k, flat[k]); }} catch(e) {{}}
    }});
