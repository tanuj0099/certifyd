// ── Domain display labels ─────────────────────────────────
var DOMAIN_LABELS = {
  tech:          'Cloud & Tech',
  data:          'Data & AI',
  cybersecurity: 'Cybersecurity',
  management:    'Project Mgmt',
  finance:       'Finance',
